    "ai-company:local-supervisor-audit": "node scripts/audit-local-supervisor.mjs",
    "ai-company:macro-hydration-benchmark": "node scripts/benchmark-macro-hydration-concurrency.mjs",
    "ai-company:continuity-simulation": "node --import tsx scripts/run-founderless-continuity-simulation.mjs",
    "ai-company:semantic-benchmark": "node --import tsx scripts/run-semantic-review-benchmark.mjs",
    "ai-company:doctor": "node scripts/ai-company-doctor.mjs",
    "ai-company:product-discovery": "node --import tsx scripts/run-product-discovery.mjs",
    "ai-company:score-audit": "node scripts/audit-scorecard-consistency.mjs",
    "ai-company:cycle-audit": "node scripts/audit-codex-product-cycle-integrity.mjs",
    "ai-company:workflows": "node --import tsx scripts/validate-ai-company-workflows.mjs",
