    "ai-company:manifest": "node scripts/generate-ai-company-manifest.mjs",
    "ai-company:security-audit": "node scripts/audit-ai-company-secrets.mjs",
    "ai-company:synthetic-audit": "REQUIRE_NO_SYNTHETIC=true node scripts/audit-synthetic-series.mjs",
    "ai-company:macro-os-corpus": "node --import tsx scripts/run-macro-os-corpus.mjs",
    "ai-company:catalog-metadata": "node --import tsx scripts/generate-indicator-catalog-metadata.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run ai-company:gate"
  },
