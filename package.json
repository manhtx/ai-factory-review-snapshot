    "forecast:evaluate": "node scripts/evaluate-forecast-batch.mjs",
    "debate:batch": "node scripts/run-llm-debate-batch.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server api scripts vite.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:ai-company": "vitest run server/aiCompany",
    "ai-company:operating-audit": "REQUIRE_AI_COMPANY_OPERATING_MODEL=true AI_COMPANY_OPERATING_AUDIT_FILE=.ai-company/reports/ai-company-operating-audit-latest.json node scripts/audit-ai-company-operating-model.mjs",
