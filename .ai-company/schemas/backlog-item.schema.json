{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BacklogItem",
  "type": "object",
  "required": [
    "id",
    "title",
    "problem",
    "persona_jtbd",
    "evidence",
    "severity",
    "value",
    "confidence",
    "effort",
    "risk",
    "horizon",
    "owner_role",
    "dependencies",
    "acceptance_criteria",
    "verification_method",
    "status",
    "source_epoch"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "problem": { "type": "string" },
    "persona_jtbd": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "severity": { "type": "string", "enum": ["blocker", "critical", "major", "minor", "enhancement"] },
    "value": { "type": "number", "minimum": 1, "maximum": 10 },
    "confidence": { "type": "number", "minimum": 1, "maximum": 10 },
    "effort": { "type": "number", "minimum": 1, "maximum": 10 },
    "risk": { "type": "number", "minimum": 1, "maximum": 10 },
    "horizon": { "type": "string", "enum": ["H0", "H1", "H2", "H3"] },
    "owner_role": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "verification_method": { "type": "string" },
    "status": { "type": "string", "enum": ["candidate", "planned", "in_progress", "verified_done", "rejected", "blocked"] },
    "source_epoch": { "type": "integer" },
    "completed_epoch": { "type": "integer" }
  }
}
